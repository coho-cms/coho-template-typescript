{
  "name": "@your-org/content",
  "version": "0.1.0",
  "description": "Typed content for our sites and services, generated from Coho CMS.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "pull": "coho-codegen pull",
    "generate": "coho-codegen generate",
    "check": "coho-codegen check",
    "catalog": "node scripts/catalog.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test test/*.test.ts",
    "prepack": "coho-codegen check && npm run build"
  },
  "peerDependencies": {
    "@coho-cms/delivery": "^2026.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@coho-cms/codegen": "2026.1.0",
    "@coho-cms/delivery": "2026.1.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2"
  }
}
