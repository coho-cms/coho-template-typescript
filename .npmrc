# While in testing, the @coho-cms packages are published to GitHub Packages, which
# needs a token even to install public packages: a personal access token (classic)
# with read:packages locally, the workflow's own token in CI. Remove these lines
# once they are on npm.
@coho-cms:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
