# A Coho project token with read access, for `npm run pull` only.
# Copy this file to .env for local runs; CI sets COHO_TOKEN as a secret.
# Never deploy it with a site or service: they need only a delivery key.
COHO_TOKEN=

# For `npm run catalog`, which reads content the way an app does: where delivery is,
# and a delivery key for the project.
COHO_DELIVERY_URL=https://delivery.coho.example
COHO_DELIVERY_KEY=
# The tag or environment to read. Empty means the ref in coho.config.json.
COHO_DELIVERY_REF=
